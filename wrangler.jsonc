{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "name": "tablekind-kitchen-demo",
  // Resolved by Astro after `npm run build` into dist/server/entry.mjs.
  // Do not run `wrangler deploy` without building first.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  },
  // Existing namespace from an earlier deploy attempt. Pinning the ID prevents
  // "namespace ... already exists" during auto-provision. Safe to keep even
  // though Astro sessions are disabled for this demo.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "db81c3ea2e7841d98cc210a4db8ea1bd"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    "PUBLIC_DEMO_MODE": "true",
    "PUBLIC_SITE_URL": "https://tablekindkitchen.chexustudio.com",
    "PUBLIC_STUDIO_URL": "https://chexustudio.com",
    "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/",
    "PUBLIC_PACKAGES_URL": "https://chexustudio.com/pricing/",
    "ALLOWED_ORIGINS": "https://tablekindkitchen.chexustudio.com,http://localhost:4321"
  },
  // Omit database_id so Wrangler auto-provisions D1 on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tablekind-leads",
      "migrations_dir": "migrations"
    }
  ],
  // Optional: enable Workers AI in production dashboards when desired.
  // Local assistant falls back safely without this binding.
  // "ai": { "binding": "AI", "remote": true },
  "env": {
    "staging": {
      "name": "tablekind-kitchen-demo-staging",
      "vars": {
        "DEMO_MODE": "true",
        "PUBLIC_DEMO_MODE": "true",
        "PUBLIC_SITE_URL": "https://tablekind-kitchen-demo-staging.workers.dev",
        "PUBLIC_STUDIO_URL": "https://chexustudio.com",
        "PUBLIC_CASE_STUDY_URL": "https://chexustudio.com/work/",
        "PUBLIC_PACKAGES_URL": "https://chexustudio.com/pricing/",
        "ALLOWED_ORIGINS": "https://tablekind-kitchen-demo-staging.workers.dev,http://localhost:4321"
      }
    }
  }
}

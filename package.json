{
  "name": "tablekind-kitchen-demo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Tablekind Kitchen — fictional restaurant portfolio demo by Che Xu Studio",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir=.wrangler-bundle",
    "db:local": "wrangler d1 migrations apply tablekind-leads --local",
    "prepare:hooks": "echo 'No git hooks configured'"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.118.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.3",
    "eslint": "^9.32.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.8.0",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}

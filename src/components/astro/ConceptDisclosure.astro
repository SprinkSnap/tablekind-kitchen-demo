---
import { DISCLOSURE } from '../../lib/config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside
  class:list={['disclosure', 'concept-disclosure', compact && 'concept-disclosure--compact']}
  aria-label="Portfolio disclosure"
>
  {
    DISCLOSURE.lines.map((line) => (
      <p>
        <strong>{line}</strong>
      </p>
    ))
  }
</aside>

<style>
  .concept-disclosure {
    border-left: 3px solid var(--color-harbour);
    background: rgb(255 254 251 / 0.94);
  }

  .concept-disclosure p {
    margin: 0;
  }

  .concept-disclosure p + p {
    margin-top: 0.35rem;
  }

  .concept-disclosure strong {
    font-weight: 700;
    color: var(--color-dark-pine);
  }

  .concept-disclosure--compact {
    padding: 0.75rem 0.9rem;
    font-size: 0.88rem;
  }
</style>

---

---

<nav class="mobile-actions" aria-label="Quick store actions">
  <a href="/shop/" class="mobile-actions__item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4 7h16l-1.5 11H5.5L4 7zm2.2-3h15.6L22 6H2l4.2-2z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
    <span>Shop</span>
  </a>
  <a href="/search/" class="mobile-actions__item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M16 16l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
    <span>Search</span>
  </a>
  <a href="/wishlist/" class="mobile-actions__item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 20.5s-6.2-3.9-8.4-7.4C1.8 9.8 3.6 6 7.1 6c1.9 0 3.2 1 4 2.1.8-1.1 2.1-2.1 4-2.1 3.5 0 5.3 3.8 3.5 7.1C18.2 16.6 12 20.5 12 20.5z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
    <span>Wishlist</span>
  </a>
  <a href="/cart/" class="mobile-actions__item" data-open-cart>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 6h15l-1.5 9h-12L6 6zm0 0L5 3H2"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <circle cx="9.5" cy="19.5" r="1.25" fill="currentColor"></circle>
      <circle cx="17.5" cy="19.5" r="1.25" fill="currentColor"></circle>
    </svg>
    <span>Cart</span>
  </a>
  <button type="button" class="mobile-actions__item mobile-actions__cta" data-open-enquiry data-track="che_xu_cta_selected">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4 18V6l8 6 8-6v12H4z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
    <span>Build a Store</span>
  </button>
</nav>

<style>
  .mobile-actions {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 35;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.45rem 0.5rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
    background: rgb(255 254 251 / 0.96);
    border-top: 1px solid rgb(23 59 50 / 0.12);
    backdrop-filter: blur(10px);
  }

  .mobile-actions__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: 52px;
    padding: 0.25rem 0.15rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-pine);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }

  .mobile-actions__item:hover,
  .mobile-actions__item:focus-visible {
    background: rgb(23 59 50 / 0.06);
  }

  .mobile-actions__cta {
    color: var(--color-porcelain);
    background: var(--color-harbour);
    border-color: transparent;
  }

  .mobile-actions__cta:hover,
  .mobile-actions__cta:focus-visible {
    background: #1f4a55;
    color: var(--color-porcelain);
  }

  @media (min-width: 768px) {
    .mobile-actions {
      display: none;
    }
  }
</style>

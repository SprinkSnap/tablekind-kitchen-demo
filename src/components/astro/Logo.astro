---
interface Props {
  variant?: 'dark' | 'light';
  compact?: boolean;
}

const { variant = 'dark', compact = false } = Astro.props;
const color = variant === 'light' ? '#F7F2E8' : '#18392B';
const accent = variant === 'light' ? '#C99A45' : '#C76548';
---

<a href="/" class="logo" aria-label="Tablekind Kitchen home">
  <svg
    class="logo__mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    width="40"
    height="40"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="64" height="64" rx="14" fill={color}></rect>
    <path d="M18 18h28v6H36v22h-8V24H18v-6z" fill={variant === 'light' ? '#10271E' : '#F7F2E8'}
    ></path>
    <path d="M40 40c6 0 10 3 10 8H30c0-5 4-8 10-8z" fill={accent}></path>
  </svg>
  {
    !compact && (
      <span class="logo__wordmark" style={`color:${color}`}>
        <span class="logo__name">Tablekind</span>
        <span class="logo__kitchen" style={`color:${accent}`}>Kitchen</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    min-height: 44px;
  }

  .logo__mark {
    flex-shrink: 0;
  }

  .logo__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .logo__kitchen {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>

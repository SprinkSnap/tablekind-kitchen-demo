---
import { COLLECTIONS } from '../../data/products';
import { DISCLOSURE, STORE, STUDIO, getPackagesUrl, getStudioUrl } from '../../lib/config';
import Logo from './Logo.astro';

const packagesUrl = getPackagesUrl();
const studioUrl = getStudioUrl();
---

<footer class="site-footer">
  <div class="container-page site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="light" />
      <p class="tagline">{STORE.tagline}</p>
      <p class="disclosure disclosure--footer">{DISCLOSURE.short}</p>
    </div>

    <nav aria-label="Shop">
      <h2>Shop</h2>
      <ul>
        <li><a href="/shop/">All products</a></li>
        <li><a href="/shop/?sort=newest">New &amp; featured</a></li>
        <li><a href="/collections/">Collections</a></li>
        <li><a href="/search/">Search</a></li>
        <li><a href="/wishlist/">Wishlist</a></li>
        <li><a href="/cart/">Cart</a></li>
      </ul>
    </nav>

    <nav aria-label="Collections">
      <h2>Collections</h2>
      <ul>
        {
          COLLECTIONS.map((collection) => (
            <li>
              <a href={`/collections/${collection.slug}/`}>{collection.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Help">
      <h2>Help</h2>
      <ul>
        <li><a href="/shipping/">Shipping</a></li>
        <li><a href="/returns/">Returns</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/about/">Our story</a></li>
      </ul>
    </nav>

    <div class="site-footer__studio">
      <h2>{STUDIO.name}</h2>
      <p>
        Want a storefront like this for your home goods or lifestyle brand? Che Xu Studio designs
        conversion-focused e-commerce experiences with clarity and craft.
      </p>
      <div class="footer-actions">
        <button type="button" class="btn btn-accent" data-open-enquiry data-track="che_xu_cta_selected">
          Build a Store Like This
        </button>
        <a class="btn btn-secondary" href={packagesUrl} target="_blank" rel="noopener noreferrer">
          View packages
        </a>
        <a class="btn btn-ghost footer-studio-link" href={studioUrl} target="_blank" rel="noopener noreferrer">
          Visit {STUDIO.name}
        </a>
      </div>
    </div>
  </div>

  <div class="container-page site-footer__base">
    <p>
      © {new Date().getFullYear()} {STUDIO.name}. {STORE.name} is a fictional portfolio demonstration.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding: 3rem 0 6.5rem;
    background: var(--color-dark-pine);
    color: var(--color-linen);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 3rem;
    }
  }

  .site-footer__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .site-footer__grid {
      grid-template-columns: 1.35fr 0.9fr 0.9fr 0.9fr 1.2fr;
      gap: 2rem;
    }
  }

  .tagline {
    margin: 1rem 0 0.75rem;
    color: rgb(247 243 236 / 0.82);
    max-width: 22rem;
    line-height: 1.55;
  }

  .disclosure--footer {
    background: rgb(255 254 251 / 0.06);
    border-color: rgb(255 254 251 / 0.12);
    color: rgb(247 243 236 / 0.9);
    max-width: 24rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.8rem;
    color: var(--color-porcelain);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  a,
  .footer-actions button {
    color: rgb(247 243 236 / 0.92);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  a:hover {
    color: var(--color-sand);
  }

  .site-footer__studio p {
    margin: 0;
    color: rgb(247 243 236 / 0.82);
    line-height: 1.6;
    max-width: 24rem;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .footer-actions .btn-secondary {
    color: var(--color-linen);
    border-color: rgb(247 243 236 / 0.35);
    background: transparent;
  }

  .footer-actions .btn-secondary:hover {
    background: rgb(247 243 236 / 0.08);
    border-color: rgb(247 243 236 / 0.55);
  }

  .footer-studio-link {
    border-color: rgb(247 243 236 / 0.22) !important;
    color: rgb(247 243 236 / 0.92) !important;
    background: transparent !important;
  }

  .site-footer__base {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 254 251 / 0.12);
    font-size: 0.88rem;
    color: rgb(247 243 236 / 0.7);
  }
</style>

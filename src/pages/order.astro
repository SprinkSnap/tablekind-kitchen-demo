---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import OrderDemo from '../components/react/OrderDemo';
import { DISCLOSURE } from '../lib/config';
import { breadcrumbSchema } from '../lib/seo';

const initialItemSlug = Astro.url.searchParams.get('item') ?? undefined;
const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Order Pickup', path: '/order/' },
  ]),
];
---

<BaseLayout
  title="Order Pickup"
  description="Demo pickup ordering for Tablekind Kitchen—modifiers, cart, sample tax and local completion with no real payment."
  path="/order/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Order Pickup' }]} />
    <h1 class="section-title">Order Pickup</h1>
    <p class="section-lede">
      Browse pickup dishes, customize items and complete a local demo checkout.
    </p>
    <p class="disclosure">{DISCLOSURE.ordering}</p>
    <OrderDemo client:load initialItemSlug={initialItemSlug} />
  </section>
</BaseLayout>

---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import { DISCLOSURE, STUDIO, STORE } from '../lib/config';
import { breadcrumbSchema } from '../lib/seo';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Our Story', path: '/about/' },
  ]),
];
---

<BaseLayout
  title="Our Story"
  description={`Learn about the ${STORE.name} concept—a fictional modern Canadian home and lifestyle demonstration by ${STUDIO.name}.`}
  path="/about/"
  schemas={schemas}
>
  <section class="section container-page about">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Our Story' }]} />
    <h1 class="section-title">Our Story</h1>
    <p class="section-lede">Thoughtful pieces for everyday living—with calm design and clear product information.</p>
    <div class="disclosure">{DISCLOSURE.short}</div>
    <div class="prose">
      <p>
        {STORE.name} is imagined as a modern Canadian home and lifestyle brand: curated collections,
        restrained colour palettes and products chosen for real rooms and everyday routines. The
        experience is designed around how people actually shop—browsing collections, comparing
        details, saving favourites and moving confidently toward checkout.
      </p>
      <p>
        This story intentionally avoids inventing founders, employees, suppliers, press features or
        award histories. The focus is the storefront itself: a fast, accessible, conversion-minded
        e-commerce demonstration that business owners can evaluate as a model for their own catalogue.
      </p>
      <p>
        The aesthetic draws on calm coastal and forest tones—pine, harbour blue, sand and linen—suited
        to Canadian homes without claiming a specific neighbourhood, warehouse or retail location.
      </p>
      <p>
        If you run a home, lifestyle or retail brand and want a store with this level of care,
        {STUDIO.name} can design and build it around your verified products, operations and goals.
      </p>
    </div>
    <button type="button" class="btn btn-accent" data-open-enquiry>Build a Store Like This</button>
  </section>
</BaseLayout>

<style>
  .about .prose {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    margin: 1.5rem 0;
    line-height: 1.7;
  }

  .disclosure {
    margin: 1rem 0;
  }
</style>

---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import { DISCLOSURE, getCaseStudyUrl, getPackagesUrl, getStudioUrl, STUDIO, STORE } from '../lib/config';
import { breadcrumbSchema } from '../lib/seo';

const studioUrl = getStudioUrl();

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]),
];
---

<BaseLayout
  title="Contact"
  description={`Contact ${STUDIO.name} about building an e-commerce store like ${STORE.name}. No fictional store phone or street address.`}
  path="/contact/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
    <h1 class="section-title">Contact</h1>
    <p class="section-lede">
      All genuine business enquiries go to {STUDIO.name}. {STORE.name} does not accept real orders,
      product questions or store support messages.
    </p>
    <div class="disclosure">{DISCLOSURE.short}</div>
    <div class="surface panel">
      <h2>Work with Che Xu Studio</h2>
      <p>
        Request a website plan for your home, lifestyle or retail brand. Tell us about your catalogue,
        features and timing—we will follow up with next steps.
      </p>
      <p>
        Use the enquiry drawer on any page, or visit
        <a href={studioUrl} target="_blank" rel="noopener noreferrer">{studioUrl}</a>.
      </p>
      <div class="actions">
        <button type="button" class="btn btn-accent" data-open-enquiry>Request My Website Plan</button>
        <a class="btn btn-secondary" href={getPackagesUrl()} target="_blank" rel="noopener noreferrer">
          View Packages
        </a>
        <a class="btn btn-ghost" href={getCaseStudyUrl()} target="_blank" rel="noopener noreferrer">
          View Case Study
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .panel {
    padding: 1.25rem;
    margin-top: 1.25rem;
    max-width: 40rem;
  }

  .panel h2 {
    font-family: var(--font-display);
    color: var(--color-dark-pine);
    margin-top: 0;
  }

  .panel a {
    color: var(--color-harbour);
    text-decoration: underline;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .disclosure {
    margin: 1rem 0;
  }
</style>

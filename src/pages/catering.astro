---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import CateringPlanner from '../components/react/CateringPlanner';
import { breadcrumbSchema } from '../lib/seo';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Catering', path: '/catering/' },
  ]),
];
---

<BaseLayout
  title="Catering"
  description="Plan a demo catering enquiry for meetings and gatherings. Fictional Tablekind enquiries are not transmitted."
  path="/catering/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Catering' }]} />
    <h1 class="section-title">Catering for Meetings and Gatherings</h1>
    <p class="section-lede">
      Collect useful event details in a clear planner, then invite real businesses to build the same
      flow with Che Xu Studio.
    </p>
    <CateringPlanner client:load variant="catering" />
  </section>
</BaseLayout>

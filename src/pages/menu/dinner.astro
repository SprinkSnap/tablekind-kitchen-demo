---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import MenuFilters from '../../components/react/MenuFilters';
import { getItemsByCategory, DIETARY_LABELS, type MenuCategory } from '../../data/menu';
import { DISCLOSURE } from '../../lib/config';
import { formatCad } from '../../lib/currency';
import { breadcrumbSchema, menuSchema } from '../../lib/seo';

const categories: MenuCategory[] = ['small-plates', 'mains', 'sides'];
const groups = categories.map((category) => ({
  category,
  items: getItemsByCategory(category),
}));
const schemas = [
  menuSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Menu', path: '/menu/' },
    { name: 'Dinner', path: '/menu/dinner/' },
  ]),
];
---

<BaseLayout
  title="Dinner Menu"
  description="Dinner at Tablekind Kitchen demo—small plates, seasonal mains and sides with clear CAD pricing."
  path="/menu/dinner/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Menu', href: '/menu/' },
        { name: 'Dinner' },
      ]}
    />
    <h1 class="section-title">Dinner</h1>
    <p class="section-lede">Seasonal dinners with neighbourhood warmth—small plates, mains and sides.</p>
    <p class="disclosure">{DISCLOSURE.dietary}</p>
    {
      groups.map((group) => (
        <section class="group">
          <h2>{group.category.replace('-', ' ')}</h2>
          <ul class="static-list">
            {group.items.map((item) => (
              <li>
                <div class="row">
                  <h3>{item.name}</h3>
                  <p class="price">{formatCad(item.price)}</p>
                </div>
                <p>{item.description}</p>
                {item.dietaryLabels.length > 0 && (
                  <p>{item.dietaryLabels.map((l) => DIETARY_LABELS[l]).join(' · ')}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <MenuFilters client:load initialCategory="mains" showAddButtons />
  </section>
</BaseLayout>

<style>
  .group { margin-top: 1.5rem; }
  .group h2 {
    text-transform: capitalize;
    font-family: var(--font-display);
    color: #10271E;
  }
  .static-list { list-style: none; margin: 1rem 0; padding: 0; display: grid; gap: 1rem; }
  .static-list li {
    padding: 1rem;
    border-radius: 1rem;
    background: rgb(255 253 252 / 0.8);
    border: 1px solid rgb(24 57 43 / 0.08);
  }
  .row { display: flex; justify-content: space-between; gap: 1rem; }
  h3 { margin: 0; font-size: 1.15rem; color: #10271E; }
</style>

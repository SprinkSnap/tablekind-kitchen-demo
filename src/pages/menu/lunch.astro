---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import MenuFilters from '../../components/react/MenuFilters';
import { getItemsByCategory, DIETARY_LABELS } from '../../data/menu';
import { DISCLOSURE } from '../../lib/config';
import { formatCad } from '../../lib/currency';
import { breadcrumbSchema, menuSchema } from '../../lib/seo';

const items = getItemsByCategory('lunch');
const schemas = [
  menuSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Menu', path: '/menu/' },
    { name: 'Lunch', path: '/menu/lunch/' },
  ]),
];
---

<BaseLayout
  title="Lunch Menu"
  description="Midday lunch dishes from the Tablekind Kitchen demo—salads, sandwiches, bowls and soups."
  path="/menu/lunch/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Menu', href: '/menu/' },
        { name: 'Lunch' },
      ]}
    />
    <h1 class="section-title">Lunch</h1>
    <p class="section-lede">Bright midday dishes for tables and takeaway.</p>
    <p class="disclosure">{DISCLOSURE.dietary}</p>
    <MenuFilters client:load initialCategory="lunch" showAddButtons />
    <noscript>
      <ul class="static-list">
        {
          items.map((item) => (
            <li>
              <div class="row">
                <h2>{item.name}</h2>
                <p class="price">{formatCad(item.price)}</p>
              </div>
              <p>{item.description}</p>
              {item.dietaryLabels.length > 0 && (
                <p>{item.dietaryLabels.map((l) => DIETARY_LABELS[l]).join(' · ')}</p>
              )}
            </li>
          ))
        }
      </ul>
    </noscript>
  </section>
</BaseLayout>

<style>
  .static-list { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 1rem; }
  .static-list li {
    padding: 1rem;
    border-radius: 1rem;
    background: rgb(255 253 252 / 0.8);
    border: 1px solid rgb(24 57 43 / 0.08);
  }
  .row { display: flex; justify-content: space-between; gap: 1rem; }
  h2 { margin: 0; font-size: 1.2rem; font-family: var(--font-display); color: #10271E; }
</style>

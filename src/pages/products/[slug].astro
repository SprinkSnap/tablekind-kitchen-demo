---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import StudioCta from '../../components/astro/StudioCta.astro';
import ProductPurchase from '../../components/react/ProductPurchase';
import {
  getCollection,
  getRelatedProducts,
  PRODUCTS,
  type Product,
} from '../../data/products';
import { formatCad } from '../../lib/currency';
import { DISCLOSURE } from '../../lib/config';
import { breadcrumbSchema } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = () =>
  PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));

interface Props {
  product: Product;
}

const { product } = Astro.props;
const collection = getCollection(product.collection);
const related = getRelatedProducts(product, 4);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: collection?.name ?? 'Shop', path: `/collections/${product.collection}/` },
    { name: product.name, path: `/products/${product.slug}/` },
  ]),
];
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  path={`/products/${product.slug}/`}
  schemas={schemas}
>
  <article class="section container-page product-page">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        {
          name: collection?.name ?? 'Shop',
          href: `/collections/${product.collection}/`,
        },
        { name: product.name },
      ]}
    />

    <div class="product-layout">
      <div class="product-gallery" aria-label="Product images">
        {
          product.images.map((src, index) => (
            <figure class:list={['gallery-figure', index === 0 && 'gallery-figure--default']} id={`image-${index}`}>
              <img
                src={src}
                alt={product.imageAlt[index] ?? product.name}
                width="900"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="gallery-figure__image aspect-square"
              />
            </figure>
          ))
        }
        {
          product.images.length > 1 && (
            <nav class="gallery-thumbs" aria-label="Image thumbnails">
              {
                product.images.map((src, index) => (
                  <a href={`#image-${index}`} class="gallery-thumb">
                    <img
                      src={src}
                      alt=""
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                      class="aspect-square"
                    />
                  </a>
                ))
              }
            </nav>
          )
        }
      </div>

      <div class="product-details">
        <p class="eyebrow">{collection?.name}</p>
        <h1>{product.name}</h1>
        <p class="product-short">{product.shortDescription}</p>
        <p class="product-price">
          <span class="price">{formatCad(product.price)}</span>
          {
            product.compareAtPrice && product.compareAtPrice > product.price && (
              <span class="product-compare">{formatCad(product.compareAtPrice)}</span>
            )
          }
        </p>

        <ProductPurchase client:load productId={product.id} />

        <div class="product-copy">
          <p>{product.description}</p>
        </div>

        <dl class="product-specs">
          <div>
            <dt>Materials</dt>
            <dd>{product.materials.join(', ')}</dd>
          </div>
          <div>
            <dt>Dimensions</dt>
            <dd>{product.dimensions}</dd>
          </div>
          <div>
            <dt>Care</dt>
            <dd>{product.care}</dd>
          </div>
        </dl>

        <section class="product-policies" aria-labelledby="shipping-returns">
          <h2 id="shipping-returns">Shipping &amp; returns</h2>
          <p>{DISCLOSURE.sampleShipping}</p>
          <p>{DISCLOSURE.sampleReturns}</p>
          <p class="visually-quiet">
            <a href="/shipping/">Sample shipping policy</a>
            {' · '}
            <a href="/returns/">Sample returns policy</a>
          </p>
        </section>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="section-title">You may also like</h2>
          <div class="product-grid">
            {related.map((item) => <ProductCard product={item} />)}
          </div>
        </section>
      )
    }

    <StudioCta class="product-cta" />
  </article>
</BaseLayout>

<style>
  .product-layout {
    display: grid;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .product-layout {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
    }
  }

  .product-gallery {
    display: grid;
    gap: 0.75rem;
  }

  .gallery-figure {
    margin: 0;
    display: none;
  }

  .gallery-figure--default {
    display: block;
  }

  .gallery-figure:target {
    display: block;
  }

  .product-gallery:has(.gallery-figure:target) .gallery-figure--default:not(:target) {
    display: none;
  }

  .gallery-figure__image,
  .aspect-square {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-linen);
  }

  .gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gallery-thumb {
    display: block;
    width: 4.5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .gallery-thumb:hover,
  .gallery-thumb:focus-visible {
    border-color: var(--color-harbour);
  }

  .gallery-thumb img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .product-details h1 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    line-height: 1.15;
    color: var(--color-dark-pine);
  }

  .product-short {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgb(36 40 36 / 0.82);
  }

  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
  }

  .product-compare {
    font-size: 0.95rem;
    color: rgb(36 40 36 / 0.55);
    text-decoration: line-through;
    font-weight: 500;
  }

  .product-copy {
    margin-top: 1.5rem;
    line-height: 1.7;
    color: rgb(36 40 36 / 0.85);
  }

  .product-specs {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.85rem;
  }

  .product-specs dt {
    font-weight: 700;
    color: var(--color-dark-pine);
    margin-bottom: 0.2rem;
  }

  .product-specs dd {
    margin: 0;
    line-height: 1.6;
    color: rgb(36 40 36 / 0.82);
  }

  .product-policies {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(23 59 50 / 0.1);
  }

  .product-policies h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-dark-pine);
  }

  .product-policies p {
    margin: 0 0 0.5rem;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(23 59 50 / 0.08);
  }

  .related .section-title {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    margin-bottom: 1.25rem;
  }

  .product-cta {
    margin-top: 2.5rem;
  }
</style>

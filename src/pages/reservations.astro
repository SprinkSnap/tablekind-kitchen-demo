---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import ReservationFlow from '../components/react/ReservationFlow';
import { DISCLOSURE } from '../lib/config';
import { breadcrumbSchema } from '../lib/seo';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Reservations', path: '/reservations/' },
  ]),
];
---

<BaseLayout
  title="Reservations"
  description="Try the Tablekind Kitchen reservation demonstration—an accessible multistep flow that never books a real table."
  path="/reservations/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Reservations' }]} />
    <h1 class="section-title">Reservations</h1>
    <p class="section-lede">
      A short, accessible booking experience designed for restaurants. Provider-agnostic and demo-only.
    </p>
    <p class="disclosure">{DISCLOSURE.reservation}</p>
    <ReservationFlow client:load />
  </section>
</BaseLayout>

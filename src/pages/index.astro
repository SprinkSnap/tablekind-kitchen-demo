---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptDisclosure from '../components/astro/ConceptDisclosure.astro';
import ProductCard from '../components/astro/ProductCard.astro';
import StudioCta from '../components/astro/StudioCta.astro';
import ProductFinder from '../components/react/ProductFinder';
import { HOME_FAQS } from '../data/faq';
import {
  BUNDLES,
  COLLECTIONS,
  getProductById,
  getFeaturedProducts,
} from '../data/products';
import { formatCad } from '../lib/currency';
import { DISCLOSURE, getCaseStudyUrl, getPackagesUrl, STUDIO, STORE } from '../lib/config';
import { faqSchema, organizationSchema, websiteSchema } from '../lib/seo';

const featured = getFeaturedProducts(8);

const rooms = [
  { label: 'Living room', href: '/collections/living/', image: '/images/living-room.svg', alt: 'Calm living room with soft textiles and natural light' },
  { label: 'Dining area', href: '/collections/kitchen-dining/', image: '/images/dining-area.svg', alt: 'Dining table set with ceramic dinnerware and linens' },
  { label: 'Kitchen', href: '/collections/kitchen-dining/', image: '/images/kitchen.svg', alt: 'Kitchen counter with everyday tableware and storage' },
  { label: 'Workspace', href: '/collections/workspace/', image: '/images/workspace.svg', alt: 'Organized desk with tray, mat and desk accessories' },
];

const values = [
  { title: 'Thoughtful function', text: 'Products are presented with clear use cases—not hype or invented scarcity.' },
  { title: 'Clear product information', text: 'Materials, dimensions and care guidance help shoppers decide with confidence.' },
  { title: 'Calm design', text: 'A restrained palette and generous spacing keep focus on the catalogue.' },
  { title: 'Easy shopping', text: 'Filters, wishlist and a demo cart show how everyday purchases can feel simple.' },
  { title: 'Responsive customer experience', text: 'Mobile-first layouts, accessible controls and fast page loads across the journey.' },
];

const capabilities = [
  'Collection and category navigation',
  'Search-friendly product pages',
  'Variant selectors and wishlist',
  'Demo cart and checkout flow',
  'Filter and sort architecture',
  'Responsive product imagery',
  'Structured SEO foundations',
  'Accessible interactions',
  'Conversion analytics hooks',
];

const bundleCards = BUNDLES.map((bundle) => {
  const products = bundle.productIds
    .map((id) => getProductById(id))
    .filter((product): product is NonNullable<typeof product> => Boolean(product));
  const bundleTotal = products.reduce((sum, product) => sum + product.price, 0);
  return { ...bundle, products, bundleTotal };
});

const schemas = [websiteSchema(), organizationSchema(), faqSchema()];
---

<BaseLayout
  title="Thoughtful Pieces for Everyday Living"
  description={`${STORE.name} is a modern Canadian home and lifestyle store concept by ${STUDIO.name}—featuring curated collections, product discovery, wishlist, demo cart and checkout.`}
  path="/"
  schemas={schemas}
>
  <section class="hero-atmosphere" aria-labelledby="hero-heading">
    <div class="container-page hero__inner fade-up">
      <ConceptDisclosure compact />
      <p class="eyebrow hero__eyebrow">Modern Home Essentials</p>
      <h1 id="hero-heading">Thoughtful Pieces for Everyday Living.</h1>
      <p class="hero__lede">
        A curated collection of practical, beautifully designed objects created to make everyday
        spaces feel more comfortable and considered.
      </p>
      <div class="hero__actions">
        <a class="btn btn-accent" href="/shop/">Shop the Collection</a>
        <a class="btn btn-ghost" href="/shop/?sort=newest">Explore New Arrivals</a>
        <button type="button" class="btn btn-ghost" data-open-enquiry>Build a Store Like This</button>
      </div>
      <p class="hero__reassure">
        Interactive store demonstration—no real orders or payments. {DISCLOSURE.short}
      </p>
    </div>
  </section>

  <section class="section container-page" aria-labelledby="collections-heading">
    <h2 id="collections-heading" class="section-title">Shop by Collection</h2>
    <p class="section-lede">
      Six curated collections spanning living, dining, textiles, storage, workspace and gifts.
    </p>
    <ul class="collection-grid">
      {
        COLLECTIONS.map((collection) => (
          <li>
            <a class="collection-card surface" href={`/collections/${collection.slug}/`}>
              <img
                src={collection.image}
                alt={collection.imageAlt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
              <div class="collection-card__body">
                <h3>{collection.name}</h3>
                <p>{collection.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container-page" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="section-title">Featured Products</h2>
    <p class="section-lede">A sample of the demo catalogue—ready to browse, filter or add to a demo cart.</p>
    <div class="product-grid">
      {featured.map((product, index) => <ProductCard product={product} eager={index < 4} />)}
    </div>
    <p class="section-cta">
      <a class="btn btn-secondary" href="/shop/">View all products</a>
    </p>
  </section>

  <section class="section values" aria-labelledby="values-heading">
    <div class="container-page">
      <h2 id="values-heading" class="section-title">Designed for Real Homes and Everyday Routines.</h2>
      <ul class="values-grid">
        {
          values.map((item) => (
            <li class="surface values-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container-page" aria-labelledby="rooms-heading">
    <h2 id="rooms-heading" class="section-title">Shop by Room</h2>
    <p class="section-lede">Start with a room in mind—each link opens a relevant collection from the demo catalogue.</p>
    <ul class="room-grid">
      {
        rooms.map((room) => (
          <li>
            <a class="room-card surface" href={room.href}>
              <img src={room.image} alt={room.alt} width="800" height="600" loading="lazy" decoding="async" />
              <span>{room.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container-page" aria-labelledby="finder-heading">
    <h2 id="finder-heading" class="section-title">Find the Right Piece</h2>
    <p class="section-lede">Answer a few quick questions to see matching products from the demo catalogue.</p>
    <ProductFinder client:visible />
  </section>

  <section class="section container-page" aria-labelledby="bundles-heading">
    <h2 id="bundles-heading" class="section-title">Complete the Space</h2>
    <p class="section-lede">
      Illustrative product groupings for inspiration. Add each item individually—no automatic discounts
      are applied in this demo.
    </p>
    <ul class="bundle-grid">
      {
        bundleCards.map((bundle) => (
          <li class="bundle-card surface">
            <h3>{bundle.name}</h3>
            <p>{bundle.description}</p>
            <ul class="bundle-products">
              {
                bundle.products.map((product) => (
                  <li>
                    <a href={`/products/${product.slug}/`}>{product.name}</a>
                    <span class="price">{formatCad(product.price)}</span>
                  </li>
                ))
              }
            </ul>
            <p class="bundle-total">
              Illustrative total: <span class="price">{formatCad(bundle.bundleTotal)}</span>
            </p>
            <p class="bundle-note">{bundle.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section showcase" aria-labelledby="showcase-heading">
    <div class="container-page">
      <h2 id="showcase-heading" class="section-title">
        Designed to Turn Product Browsing Into Confident Purchases.
      </h2>
      <ul class="showcase-grid">
        {capabilities.map((item) => <li>{item}</li>)}
      </ul>
      <button type="button" class="btn btn-accent" data-open-enquiry>Build This for My Business</button>
    </div>
  </section>

  <section class="section container-page" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="section-title">Frequently Asked Questions</h2>
    <div class="faq-list">
      {
        HOME_FAQS.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section container-page">
    <StudioCta
      heading="Your Products Deserve More Than a Generic Storefront."
      supporting={`${STUDIO.name} designs conversion-focused e-commerce experiences for home and lifestyle brands—clear navigation, polished product storytelling, and thoughtful demo flows that help you sell online with confidence.`}
      primaryLabel="Build a Store Like This"
    />
    <p class="footer-note">
      <a href={getPackagesUrl()} target="_blank" rel="noopener noreferrer">View packages</a>
      {' · '}
      <a href={getCaseStudyUrl()} target="_blank" rel="noopener noreferrer">View case study</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    max-width: 42rem;
    padding: clamp(4.5rem, 12vw, 7rem) 0 clamp(3rem, 8vw, 5rem);
    color: var(--color-porcelain);
  }

  .hero__eyebrow {
    color: var(--color-sand);
  }

  .hero h1 {
    font-size: clamp(2.35rem, 5.5vw, 4rem);
    line-height: 1.08;
    margin: 0;
    color: var(--color-porcelain);
  }

  .hero__lede {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.65;
    color: rgb(255 254 251 / 0.9);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__reassure {
    margin: 0;
    max-width: 36rem;
    font-size: 0.9rem;
    color: rgb(255 254 251 / 0.78);
  }

  .collection-grid,
  .room-grid,
  .values-grid,
  .bundle-grid,
  .showcase-grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .collection-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .collection-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .collection-card {
    display: grid;
    text-decoration: none;
    overflow: hidden;
    height: 100%;
  }

  .collection-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--color-linen);
  }

  .collection-card__body {
    padding: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  .collection-card h3 {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-dark-pine);
    font-size: 1.15rem;
  }

  .collection-card p {
    margin: 0;
    color: rgb(36 40 36 / 0.78);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .section-cta {
    margin: 1.5rem 0 0;
  }

  .values {
    background: linear-gradient(180deg, rgb(23 59 50 / 0.04), transparent);
  }

  .values-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .values-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .values-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .values-card {
    padding: 1.1rem;
  }

  .values-card h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    color: var(--color-dark-pine);
    font-size: 1.05rem;
  }

  .values-card p {
    margin: 0;
    line-height: 1.6;
    color: rgb(36 40 36 / 0.8);
    font-size: 0.95rem;
  }

  .room-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 768px) {
    .room-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .room-card {
    display: grid;
    gap: 0.65rem;
    padding: 0.65rem;
    text-decoration: none;
    text-align: center;
    font-weight: 700;
    color: var(--color-dark-pine);
  }

  .room-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-linen);
  }

  .bundle-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .bundle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .bundle-card {
    padding: 1.15rem;
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .bundle-card h3 {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-dark-pine);
  }

  .bundle-card > p {
    margin: 0;
    line-height: 1.55;
    color: rgb(36 40 36 / 0.8);
  }

  .bundle-products {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .bundle-products li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.92rem;
  }

  .bundle-products a {
    color: var(--color-harbour);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .bundle-total {
    margin: 0;
    font-weight: 650;
  }

  .bundle-note {
    margin: 0;
    font-size: 0.85rem;
    color: rgb(36 40 36 / 0.68);
  }

  .showcase {
    background: rgb(158 175 157 / 0.18);
  }

  .showcase-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .showcase-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .showcase-grid li {
    background: rgb(255 254 251 / 0.85);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    font-weight: 650;
    color: var(--color-dark-pine);
  }

  .faq-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  details {
    background: rgb(255 254 251 / 0.88);
    border: 1px solid rgb(23 59 50 / 0.1);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  details p {
    margin: 0.65rem 0 0;
    line-height: 1.65;
    color: rgb(36 40 36 / 0.82);
  }

  .footer-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    text-align: center;
    color: rgb(36 40 36 / 0.7);
  }

  .footer-note a {
    color: var(--color-harbour);
    text-decoration: underline;
  }
</style>

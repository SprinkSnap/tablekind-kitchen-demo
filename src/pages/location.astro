---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import { DISCLOSURE } from '../lib/config';
import { breadcrumbSchema } from '../lib/seo';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Location', path: '/location/' },
  ]),
];
---

<BaseLayout
  title="Location"
  description="Tablekind Kitchen is a fictional restaurant demo. No street address or phone number is published."
  path="/location/"
  schemas={schemas}
>
  <section class="section container-page">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Location' }]} />
    <h1 class="section-title">Location</h1>
    <p class="section-lede">
      Local SEO architecture is ready—accurate NAP and hours appear only for verified restaurants.
    </p>
    <div class="disclosure">
      <p><strong>No street address or phone number is published.</strong></p>
      <p>{DISCLOSURE.location}</p>
    </div>
    <div class="surface panel">
      <h2>What a real location page would include</h2>
      <ul>
        <li>Verified name, address and phone (NAP)</li>
        <li>Accurate opening hours</li>
        <li>Accessible directions and transit notes</li>
        <li>Map embed from an approved provider</li>
        <li>Restaurant / LocalBusiness structured data</li>
      </ul>
      <p>{DISCLOSURE.hours}</p>
      <p class="hours">
        Sample demo hours (illustrative only): Tue–Sun dinner 17:00–21:30 · Sat–Sun brunch
        9:00–14:00 · Closed Mondays
      </p>
    </div>
    <a class="btn btn-accent" href="#studio-enquiry" data-open-enquiry>
      Build Local SEO for My Restaurant
    </a>
  </section>
</BaseLayout>

<style>
  .panel { padding: 1.25rem; margin: 1.25rem 0; max-width: 40rem; }
  .panel h2 { font-family: var(--font-display); color: #10271E; margin-top: 0; }
  .panel ul { line-height: 1.7; }
  .hours { color: rgb(34 38 34 / 0.75); }
  .disclosure { margin: 1rem 0; }
</style>

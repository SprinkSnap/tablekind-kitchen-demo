---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { STORE } from '../lib/config';
---

<BaseLayout
  title="Page Not Found"
  description={`The page you requested is not part of the ${STORE.name} demo.`}
  path="/404/"
  showDisclosure={false}
>
  <section class="section container-page not-found">
    <p class="eyebrow">404</p>
    <h1 class="section-title">This page isn't in the catalogue.</h1>
    <p class="section-lede">
      The page you requested isn't available in this portfolio demonstration.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/shop/">Shop the collection</a>
      <a class="btn btn-secondary" href="/collections/">Browse collections</a>
      <a class="btn btn-ghost" href="/contact/">Contact Che Xu Studio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }
</style>
